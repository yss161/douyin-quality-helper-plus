<Window x:Class="DouyinQualityHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="抖音画质助手" Height="820" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F3F3F3"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- WinUI 3 / Fluent 2 视觉规范
         参照 Windows 11 设计语言：
           背景 #F3F3F3（Mica 基色）
           卡片 #FFFFFF，1px #E5E5E5 描边，8px 圆角
           强调色 #0F6CBD（Fluent 蓝）
           次级文字 #5D5D5D，三级 #8A8A8A
         字体与控件尺寸向 WinUI 靠拢，间距用 4 的倍数。
    -->

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E5E5E5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="CardSubtle" TargetType="Border">
      <Setter Property="Background" Value="#FAFAFA"/>
      <Setter Property="BorderBrush" Value="#EBEBEB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>

    <!-- 主按钮：Fluent 强调色 -->
    <Style x:Key="AccentBtn" TargetType="Button">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#0F6CBD"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#115EA3"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0C3B5E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次要按钮：白色底 + 描边（Fluent Standard Button） -->
    <Style x:Key="StdBtn" TargetType="Button">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D6D6D6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EBEBEB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 小按钮（卡片内操作） -->
    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource StdBtn}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource AccentBtn}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="#C42B1C"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#5D5D5D"/>
      <Setter Property="Width" Value="116"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8A8A8A"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Fluent 风格单选 -->
    <Style x:Key="FluentRadio" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ================= 标题栏区域 -->
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"
            Padding="24,18,24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="抖音画质助手" FontSize="22" FontWeight="SemiBold"
                       Foreground="#1A1A1A" VerticalAlignment="Center"/>
            <Border Background="#E5F1FB" CornerRadius="4" Padding="8,2" Margin="10,3,0,0"
                    VerticalAlignment="Center">
              <TextBlock x:Name="ToolVersionText" Text="v2.0.0" FontSize="11"
                         FontWeight="SemiBold" Foreground="#0F6CBD"/>
            </Border>
          </StackPanel>
          <TextBlock Text="让每个视频都用它能提供的最高清晰度播放（4K / 2K / 1080P）"
                     Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="RunBadge" Text="检测中…" FontSize="13" FontWeight="SemiBold"
                     Foreground="#8A8A8A" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 更新提示条 -->
    <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed"
            Background="#E5F1FB" BorderBrush="#B3D7F5" BorderThickness="0,0,0,1"
            Padding="24,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                   FontSize="16" Foreground="#0F6CBD" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="UpdateTitle" Text="发现新版本" FontSize="13" FontWeight="SemiBold"
                     Foreground="#0C3B5E"/>
          <TextBlock x:Name="UpdateDesc" Text="" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnGoDownload" Style="{StaticResource SmallBtn}" Margin="10,0,0,0"
                  Content="前往下载"/>
          <Button x:Name="BtnDismissUpdate" Style="{StaticResource SmallBtn}" Margin="8,0,0,0"
                  Content="稍后"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 主操作区 -->
    <Border Grid.Row="2" Background="#F3F3F3" Padding="24,14,24,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="BtnInstall" Grid.Column="0" Style="{StaticResource AccentBtn}"
                Margin="0,0,8,0" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="一键启用最高画质" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button x:Name="BtnRestore" Grid.Column="1" Style="{StaticResource StdBtn}"
                Margin="0,0,8,0" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="还原官方原版" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button x:Name="BtnCheck" Grid.Column="2" Style="{StaticResource StdBtn}"
                Margin="0,0,8,0" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="检查生效情况" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button x:Name="BtnRefresh" Grid.Column="3" Style="{StaticResource StdBtn}"
                Width="88" ToolTip="刷新状态">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                       FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="刷新" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ================= 可滚动主体 -->
    <ScrollViewer x:Name="RootScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="24,8,24,0">
      <StackPanel>

        <!-- 状态卡 -->
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                    Background="#F0F0F0" Margin="0,0,14,0">
              <TextBlock x:Name="StatusIcon" Text="&#xE9CE;"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="20" Foreground="#8A8A8A"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="StatusText" Text="正在检测…" FontSize="16" FontWeight="SemiBold"
                         Foreground="#1A1A1A" TextWrapping="Wrap"/>
              <TextBlock x:Name="StatusDetail" Text="" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 结束抖音进程 -->
        <Border x:Name="KillCard" Style="{StaticResource Card}"
                Background="#FFF4F4" BorderBrush="#F5C2C0" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock x:Name="KillTitle" Text="抖音正在运行：结束它才能启用补丁"
                         FontSize="13" FontWeight="SemiBold" Foreground="#B3261E"/>
              <TextBlock x:Name="KillDetail" Text="正在检测抖音进程…" FontSize="12"
                         Foreground="#6B4A48" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="BtnKill" Grid.Column="1" Style="{StaticResource DangerBtn}"
                    Content="结束抖音进程" VerticalAlignment="Center"
                    ToolTip="结束 douyin.exe、托盘、守护、崩溃上报等所有抖音进程"/>
          </Grid>
        </Border>

        <!-- 注入内容 + 脚本 -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="注入内容" Style="{StaticResource SectionTitle}"/>

            <RadioButton x:Name="ModeBoth" GroupName="InjectMode" IsChecked="True"
                         Style="{StaticResource FluentRadio}"
                         Content="最高画质 + 抖音优化脚本（推荐）"/>
            <RadioButton x:Name="ModeQuality" GroupName="InjectMode"
                         Style="{StaticResource FluentRadio}"
                         Content="只装最高画质（原项目功能）"/>
            <RadioButton x:Name="ModeScript" GroupName="InjectMode"
                         Style="{StaticResource FluentRadio}"
                         Content="只装抖音优化脚本（不强制画质）"/>

            <Border Style="{StaticResource CardSubtle}" Margin="0,8,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="脚本" Style="{StaticResource RowLabel}" Width="52"/>
                  <TextBlock x:Name="ScriptValue" Text="检测中…" Style="{StaticResource RowValue}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Text="位置" Style="{StaticResource RowLabel}" Width="52"/>
                  <TextBlock x:Name="ScriptPathValue" Text="-" Style="{StaticResource RowValue}"
                             Foreground="#8A8A8A" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="BtnUploadScript" Style="{StaticResource SmallBtn}"
                          Content="上传脚本更新" Margin="0,0,8,0"/>
                  <Button x:Name="BtnResetScript" Style="{StaticResource SmallBtn}"
                          Content="恢复内置脚本"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- 抖音位置 + 明细 -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="抖音位置" Style="{StaticResource SectionTitle}"/>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PathBox" Grid.Column="0" IsReadOnly="True"
                       Height="34" Padding="10,0" VerticalContentAlignment="Center"
                       Background="#FAFAFA" BorderBrush="#D6D6D6" BorderThickness="1"
                       FontSize="13" Foreground="#1A1A1A"
                       Text="尚未选择"/>
              <Button x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource AccentBtn}"
                      Height="34" Width="92" Padding="0" Margin="8,0,0,0" Content="浏览"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="抖音版本" Style="{StaticResource RowLabel}"/>
              <TextBlock x:Name="VersionValue" Text="待选择" Style="{StaticResource RowValue}"
                         FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="画质补丁" Style="{StaticResource RowLabel}"/>
              <TextBlock x:Name="PreloadValue" Text="-" Style="{StaticResource RowValue}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="程序主体" Style="{StaticResource RowLabel}"/>
              <TextBlock x:Name="AsarValue" Text="-" Style="{StaticResource RowValue}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="原始文件备份" Style="{StaticResource RowLabel}"/>
              <TextBlock x:Name="BackupValue" Text="-" Style="{StaticResource RowValue}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 软件更新 -->
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="软件更新" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
              <TextBlock x:Name="UpdateDetail" Text="尚未检查" Style="{StaticResource Hint}"/>
            </StackPanel>
            <Button x:Name="BtnCheckUpdate" Grid.Column="1" Style="{StaticResource SmallBtn}"
                    VerticalAlignment="Center" Content="检查更新"/>
          </Grid>
        </Border>

        <!-- 运行记录 -->
        <Border Background="#FCFCFC" BorderBrush="#EBEBEB" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,14" MinHeight="150">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="运行记录" FontSize="12" Foreground="#8A8A8A"
                       Margin="2,0,0,8"/>
            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#3A3A3A"
                     VerticalScrollBarVisibility="Auto"/>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ================= 底部状态栏 -->
    <Border Grid.Row="4" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0"
            Padding="24,8">
      <TextBlock x:Name="FootText" Text="" FontSize="11.5" Foreground="#8A8A8A"
                 TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>
</Window>