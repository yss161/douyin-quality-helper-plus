<Window x:Class="DouyinQualityHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="抖音画质助手" Height="740" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F6F8"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="BigBtn" TargetType="Button">
      <Setter Property="Height" Value="46"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#C9CDD4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#86909C"/>
      <Setter Property="Width" Value="120"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#1D2129"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="2,0,2,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="抖音画质助手" FontSize="21" FontWeight="Bold" Foreground="#1D2129"/>
          <Border Background="#E8F3FF" CornerRadius="6" Padding="8,3" Margin="10,4,0,0">
            <TextBlock x:Name="ToolVersionText" Text="v—" Foreground="#165DFF" FontSize="11" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <TextBlock Text="让每个视频都用它能提供的最高清晰度播放（4K / 2K / 1080P）"
                   Foreground="#86909C" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock x:Name="RunBadge" Text="检测中…" HorizontalAlignment="Right"
                 VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#86909C"/>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusIcon" Grid.Column="0" Text="…" FontSize="34"
                   VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#86909C"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="正在检测…" FontSize="17" FontWeight="SemiBold"
                     Foreground="#1D2129" TextWrapping="Wrap"/>
          <TextBlock x:Name="StatusDetail" Text="" Foreground="#86909C"
                     Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,2,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BtnInstall" Grid.Column="0" Style="{StaticResource BigBtn}"
              Content="① 一键启用最高画质" Background="#165DFF"/>
      <Button x:Name="BtnRestore" Grid.Column="1" Style="{StaticResource BigBtn}"
              Content="② 还原官方原版" Background="#F53F3F" Margin="0,0,10,0"/>
      <Button x:Name="BtnCheck"   Grid.Column="2" Style="{StaticResource BigBtn}"
              Content="③ 检查生效情况" Background="#00B42A" Margin="0,0,10,0"/>
      <Button x:Name="BtnRefresh" Grid.Column="3" Style="{StaticResource BigBtn}"
              Content="刷新" Background="#86909C" Width="78" Margin="0"/>
    </Grid>

    <!-- 结束抖音进程：启用/还原补丁前，抖音的所有进程都必须先退出 -->
    <Border Grid.Row="3" Background="#FFF1F0" CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
            BorderBrush="#FFB3AD" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="KillTitle" FontWeight="SemiBold" Foreground="#CB2634"
                     Text="抖音正在运行：结束它才能启用补丁"/>
          <TextBlock x:Name="KillDetail" Foreground="#8C5A1F" FontSize="12" Margin="0,4,10,0"
                     TextWrapping="Wrap" Text="正在检测抖音进程…"/>
        </StackPanel>
        <Button x:Name="BtnKill" Grid.Column="1" Content="结束抖音进程" Height="38" Padding="18,0"
                VerticalAlignment="Center" Cursor="Hand" BorderThickness="0" FontWeight="SemiBold"
                Background="#CB2634" Foreground="White"
                ToolTip="结束 douyin.exe、托盘、守护、崩溃上报等所有抖音进程（先请求正常退出，不行再强制结束）"/>
      </Grid>
    </Border>

    <!-- 注入方式 + 脚本管理 -->
    <Border Grid.Row="4" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="注入内容" FontWeight="SemiBold" Foreground="#1D2129" Margin="0,0,0,8"/>

        <RadioButton x:Name="ModeBoth" IsChecked="True" GroupName="InjectMode" Margin="0,0,0,6"
                     Cursor="Hand" ToolTip="画质补丁 + 抖音优化脚本（推荐）">
          <TextBlock TextWrapping="Wrap" Text="① 最高画质 + 抖音优化脚本（推荐）"/>
        </RadioButton>
        <RadioButton x:Name="ModeQuality" GroupName="InjectMode" Margin="0,0,18,6"
                     Cursor="Hand" HorizontalAlignment="Left"
                     ToolTip="只装原项目的自动最高画质，不动抖音优化脚本">
          <TextBlock TextWrapping="Wrap" Text="② 只装最高画质（原项目功能）"/>
        </RadioButton>
        <RadioButton x:Name="ModeScript" GroupName="InjectMode" Margin="0,0,18,8"
                     Cursor="Hand" HorizontalAlignment="Left"
                     ToolTip="只装抖音优化脚本，不强制画质">
          <TextBlock TextWrapping="Wrap" Text="③ 只装抖音优化脚本（不强制画质）"/>
        </RadioButton>

        <Border Background="#F7F8FA" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBlock Text="脚本：" Foreground="#86909C" Width="52"/>
              <TextBlock x:Name="ScriptValue" Foreground="#1D2129" FontWeight="SemiBold"
                         Text="检测中…" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="位置：" Foreground="#86909C" Width="52"/>
              <TextBlock x:Name="ScriptPathValue" Foreground="#86909C" FontSize="11.5"
                         Text="-" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnUploadScript" Content="上传脚本更新…" Height="32" Padding="14,0"
                      Cursor="Hand" BorderThickness="0" Background="#722ED1" Foreground="White"
                      FontWeight="SemiBold"
                      ToolTip="选中一个 .user.js 文件，只替换脚本本体，GM 兼容层和依赖保持不变"/>
              <Button x:Name="BtnResetScript" Content="恢复内置脚本" Height="32" Padding="14,0"
                      Margin="10,0,0,0" Cursor="Hand" BorderThickness="0" Background="#86909C"
                      Foreground="White"
                      ToolTip="丢弃上传的脚本，恢复成 EXE 内置的那份"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Row="5" Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
          <TextBlock Style="{StaticResource RowLabel}" Text="抖音版本"/>
          <TextBlock x:Name="VersionValue" Style="{StaticResource RowValue}" Text="待选择"
                     FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
          <TextBlock Style="{StaticResource RowLabel}" Text="画质补丁"/>
          <TextBlock x:Name="PreloadValue" Style="{StaticResource RowValue}" Text="检测中…"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
          <TextBlock Style="{StaticResource RowLabel}" Text="程序主体"/>
          <TextBlock x:Name="AsarValue" Style="{StaticResource RowValue}" Text="检测中…"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource RowLabel}" Text="原始文件备份"/>
          <TextBlock x:Name="BackupValue" Style="{StaticResource RowValue}" Text="检测中…"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="6" Background="#FFF7E8" CornerRadius="10" Padding="16" Margin="0,0,0,12"
            BorderBrush="#FFB84D" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="第一步：请选择抖音程序" FontWeight="SemiBold" Foreground="#D25F00" Margin="0,0,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="抖音位置" Foreground="#8C5A1F"/>
          <TextBox x:Name="PathBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0"
                   Background="#FFFFFF" Padding="8,6" VerticalContentAlignment="Center"
                   Foreground="#1D2129" Text="尚未选择"/>
          <Button x:Name="BtnBrowse" Grid.Column="2" Content="浏览…" Margin="10,0,0,0"
                  Height="34" Padding="16,0" Cursor="Hand" BorderThickness="0"
                  Background="#165DFF" Foreground="White"
                  ToolTip="点这里，找到抖音安装目录里的 douyin.exe 并选中它"/>
        </Grid>
        <TextBlock Foreground="#8C5A1F" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                   Text="点击「浏览…」，在抖音安装目录里选中 douyin.exe（通常在 D:\douyin\douyin.exe）。选定后才能进行下一步。"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="7" Background="#E8F3FF" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="使用步骤（三步）" FontWeight="SemiBold" Foreground="#165DFF" Margin="0,0,0,6"/>
        <TextBlock Foreground="#1D2129" TextWrapping="Wrap"
                   Text="1. 上面选好 douyin.exe；抖音还在运行时，点红色的「结束抖音进程」一键退出（只关窗口不算退出）"/>
        <TextBlock Foreground="#1D2129" TextWrapping="Wrap" Margin="0,3,0,0"
                   Text="2. 点「① 一键启用最高画质」"/>
        <TextBlock Foreground="#1D2129" TextWrapping="Wrap" Margin="0,3,0,0"
                   Text="3. 正常启动抖音看视频即可；没有 4K 的视频会自动用 2K 或 1080P，不会卡错"/>
        <TextBlock Foreground="#86909C" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="12"
                   Text="注意：4K 档通常需要登录抖音账号；本工具只修改抖音目录下的 1 个文件，可随时用「②」还原。无需安装 Node.js。"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="8" Background="#1D2129" CornerRadius="10" Padding="10" MinHeight="130">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="运行记录" Foreground="#86909C" Margin="2,0,0,6"/>
        <TextBox x:Name="LogBox" Background="Transparent" Foreground="#C9CDD4"
                 BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"/>
      </DockPanel>
    </Border>

    <TextBlock x:Name="FootText" Grid.Row="9" Foreground="#86909C" FontSize="11.5"
               Margin="2,10,2,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
  </ScrollViewer>
</Window>