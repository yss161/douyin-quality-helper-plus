<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DouyinQualityHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable=""
    Title="抖音画质助手">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部：标题 + 运行状态 + 更新提示 ============ -->
        <Grid Grid.Row="0" Padding="24,16,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="抖音画质助手" FontSize="22" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <Border Background="#0F6CBD" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock x:Name="ToolVersionText" Text="v2.0.0" FontSize="11"
                                   Foreground="White" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="让每个视频都用它能提供的最高清晰度播放（4K / 2K / 1080P）"
                           FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- 更新提示条：默认收起 -->
                <InfoBar x:Name="UpdateBar"
                         Severity="Success"
                         Title="发现新版本"
                         IsOpen="False"
                         IsClosable="True"
                         Width="360" />
                <TextBlock x:Name="RunBadge" Text="检测中…" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============ 主操作区 ============ -->
        <Grid Grid.Row="1" Padding="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnInstall" Grid.Column="0" Height="40" HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE945;" FontSize="15" />
                    <TextBlock Text="一键启用最高画质" />
                </StackPanel>
            </Button>

            <Button x:Name="BtnRestore" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE777;" FontSize="15" />
                    <TextBlock Text="还原官方原版" />
                </StackPanel>
            </Button>

            <Button x:Name="BtnCheck" Grid.Column="2" Height="40" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                    <TextBlock Text="检查生效情况" />
                </StackPanel>
            </Button>

            <Button x:Name="BtnRefresh" Grid.Column="3" Height="40" Width="88" ToolTipService.ToolTip="刷新状态">
                <FontIcon Glyph="&#xE72C;" FontSize="15" />
            </Button>
        </Grid>

        <!-- ============ 可滚动主体 ============ -->
        <ScrollViewer Grid.Row="2" Padding="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0">

                <!-- 状态卡 -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="StatusIcon" Grid.Column="0" Glyph="&#xE9CE;" FontSize="26"
                                  Margin="0,0,14,0" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SecondaryTextBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="正在检测…" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusDetail" Text="" FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 结束抖音进程 -->
                <Border x:Name="KillCard" Style="{StaticResource CardStyle}"
                        Background="#FFF4F4" BorderBrush="#F5C2C0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="KillTitle" Text="抖音正在运行：结束它才能启用补丁"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#B3261E" />
                            <TextBlock x:Name="KillDetail" Text="正在检测抖音进程…" FontSize="12"
                                       Foreground="#6B4A48" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="BtnKill" Grid.Column="1" Height="34" Padding="16,0"
                                VerticalAlignment="Center" Background="#B3261E" Foreground="White"
                                ToolTipService.ToolTip="结束 douyin.exe、托盘、守护、崩溃上报等所有抖音进程">
                            <TextBlock Text="结束抖音进程" FontSize="13" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 注入内容 + 脚本管理 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="注入内容" Style="{StaticResource SectionTitleStyle}" />

                        <RadioButton x:Name="ModeBoth" GroupName="InjectMode" IsChecked="True"
                                     Content="最高画质 + 抖音优化脚本（推荐）" />
                        <RadioButton x:Name="ModeQuality" GroupName="InjectMode"
                                     Content="只装最高画质（原项目功能）" />
                        <RadioButton x:Name="ModeScript" GroupName="InjectMode"
                                     Content="只装抖音优化脚本（不强制画质）" />

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="脚本" Style="{StaticResource FieldLabelStyle}" Width="48" />
                                    <TextBlock Grid.Column="1" x:Name="ScriptValue" Text="检测中…"
                                               Style="{StaticResource FieldValueStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="位置" Style="{StaticResource FieldLabelStyle}" Width="48" />
                                    <TextBlock Grid.Column="1" x:Name="ScriptPathValue" Text="-"
                                               Style="{StaticResource FieldValueStyle}" FontSize="12"
                                               Foreground="{ThemeResource SecondaryTextBrush}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnUploadScript" Height="32" Padding="12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE898;" FontSize="13" />
                                            <TextBlock Text="上传脚本更新" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnResetScript" Height="32" Padding="12,0">
                                        <TextBlock Text="恢复内置脚本" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 抖音位置 + 状态明细 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="抖音位置" Style="{StaticResource SectionTitleStyle}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" Grid.Column="0" IsReadOnly="True"
                                     PlaceholderText="尚未选择（点右侧「浏览」选择 douyin.exe）" />
                            <Button x:Name="BtnBrowse" Grid.Column="1" Height="32" Padding="16,0"
                                    Style="{StaticResource AccentButtonStyle}">
                                <TextBlock Text="浏览" FontSize="13" />
                            </Button>
                        </Grid>

                        <Grid RowSpacing="6" ColumnSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="抖音版本" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionValue" Text="待选择"
                                       Style="{StaticResource FieldValueStyle}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="画质补丁" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PreloadValue" Text="-"
                                       Style="{StaticResource FieldValueStyle}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="程序主体" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AsarValue" Text="-"
                                       Style="{StaticResource FieldValueStyle}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="原始文件备份" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BackupValue" Text="-"
                                       Style="{StaticResource FieldValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 更新检查 -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="软件更新" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                            <TextBlock x:Name="UpdateDetail" Text="尚未检查"
                                       FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="BtnCheckUpdate" Height="32" Padding="14,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                                    <TextBlock Text="检查更新" FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnOpenRelease" Height="32" Padding="14,0" Visibility="Collapsed"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                    <TextBlock x:Name="BtnOpenReleaseText" Text="前往下载" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 日志 -->
                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{ThemeResource CardBorderBrush}"
                        Padding="12" Margin="0,0,0,12" MinHeight="140">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="运行记录" FontSize="12"
                                   Foreground="{ThemeResource SecondaryTextBrush}" Margin="2,0,0,6" />
                        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="12"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ 底部状态栏 ============ -->
        <Border Grid.Row="3" Padding="24,8,24,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="FootText" Text="" FontSize="11.5"
                       Foreground="{ThemeResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
