<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DouyinQualityHelper</RootNamespace>
    <AssemblyName>DouyinQualityHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>抖音画质助手</AssemblyTitle>
    <Product>抖音画质助手</Product>
    <Description>让抖音 PC 版每个视频都按可用的最高清晰度播放</Description>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 手写 Program.Main 时，不要让 XAML 生成 App.g.i.cs 里的 Main -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\payload.js" />
    <EmbeddedResource Include="Resources\versions.json" />
    <EmbeddedResource Include="Resources\userscript.bundle.js" />
  </ItemGroup>

</Project>